// Generated schema — modeled after beautyhqio conventions.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  active       Boolean @default(true)
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ANALYST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  ANALYST
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
}

model WorkflowAnalysis {
 id String @id @default(cuid())
 actorId String
 workflow String
 subjectEntity String
 subjectId String
 input Json
 evidence Json
 evidenceHash String
 result Json
 model String
 receipt String?
 createdAt DateTime @default(now())
 @@index([workflow, createdAt])
}
model RecordReview {
 id String @id @default(cuid())
 actorId String
 entity String
 entityId String
 version String
 reason String
 createdAt DateTime @default(now())
 @@unique([entity, entityId, version, actorId])
}
model UsageBucket {
 id String @id
 calls Int
}
model IssuedCredential {
 token String @id
 entity String
 entityId String
 version String
 assertion Json
 createdAt DateTime @default(now())
 revokedAt DateTime?
 @@index([entity, entityId, createdAt])
}

model DomainArtifact {
 id String @id @default(cuid())
 subjectEntity String
 subjectId String
 title String
 content String
 contentHash String
 actorId String
 approvedBy String?
 createdAt DateTime @default(now())
 @@index([subjectEntity, subjectId])
}

model RecordApproval {
 id String @id
 version String
}
model DomainExecution {
 id String @id
 actorId String
 connectorId String
 action String
 subjectEntity String
 subjectId String
 version String
 status String
 result Json?
 createdAt DateTime @default(now())
}

model WorkSession {
 id String @id @default(cuid())
 actorId String
 respondentId String
 subjectEntity String
 subjectId String
 questions Json
 answers Json
 currentQuestion String?
 status String
 deadline DateTime
 createdAt DateTime @default(now())
 @@index([respondentId, createdAt])
}
model SessionMedia {
 id String @id @default(cuid())
 sessionId String
 questionId String
 actorId String
 contentType String
 bytes Bytes
 contentHash String
 createdAt DateTime @default(now())
 @@index([sessionId])
}

model AppSetting {
 id String @id
 value Json
 updatedAt DateTime @updatedAt
}

model ProcurementCase {
 id String @id @default(cuid())
 name String
 caseNumber String
 coordinator String
 allocationAuthority String
 authorizationReference String
 openedAt DateTime
 status String @default("Draft")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 inverseRecoveryTeam_procurementCaseId RecoveryTeam[] @relation("RecoveryTeam_procurementCaseId")
 inverseAuthorizedShipment_procurementCaseId AuthorizedShipment[] @relation("AuthorizedShipment_procurementCaseId")
 inverseContainer_procurementCaseId Container[] @relation("Container_procurementCaseId")
 inverseShipmentContainer_procurementCaseId ShipmentContainer[] @relation("ShipmentContainer_procurementCaseId")
 inverseTransportLeg_procurementCaseId TransportLeg[] @relation("TransportLeg_procurementCaseId")
 inverseTelemetryObservation_procurementCaseId TelemetryObservation[] @relation("TelemetryObservation_procurementCaseId")
 inverseProcurementHandoff_procurementCaseId ProcurementHandoff[] @relation("ProcurementHandoff_procurementCaseId")
 inverseLogisticsIncident_procurementCaseId LogisticsIncident[] @relation("LogisticsIncident_procurementCaseId")
 inverseOperationalTask_procurementCaseId OperationalTask[] @relation("OperationalTask_procurementCaseId")
 inverseRuleVersion_procurementCaseId RuleVersion[] @relation("RuleVersion_procurementCaseId")
 inverseDocumentRequirement_procurementCaseId DocumentRequirement[] @relation("DocumentRequirement_procurementCaseId")
}

model RecoveryTeam {
 id String @id @default(cuid())
 name String
 organization String
 lead String
 contact String
 availabilityAt DateTime
 status String @default("Draft")
 procurementCaseId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([procurementCaseId])
 linkedProcurementCaseId ProcurementCase @relation("RecoveryTeam_procurementCaseId", fields: [procurementCaseId], references: [id], onDelete: Restrict)
}

model AuthorizedShipment {
 id String @id @default(cuid())
 name String
 shipmentNumber String
 authorizationReference String
 recoveryAt DateTime
 destination String
 deadlineAt DateTime
 status String @default("Draft")
 procurementCaseId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([procurementCaseId])
 linkedProcurementCaseId ProcurementCase @relation("AuthorizedShipment_procurementCaseId", fields: [procurementCaseId], references: [id], onDelete: Restrict)
 inverseShipmentContainer_authorizedShipmentId ShipmentContainer[] @relation("ShipmentContainer_authorizedShipmentId")
 inverseTransportLeg_authorizedShipmentId TransportLeg[] @relation("TransportLeg_authorizedShipmentId")
 inverseProcurementHandoff_authorizedShipmentId ProcurementHandoff[] @relation("ProcurementHandoff_authorizedShipmentId")
 inverseLogisticsIncident_authorizedShipmentId LogisticsIncident[] @relation("LogisticsIncident_authorizedShipmentId")
}

model Container {
 id String @id @default(cuid())
 name String
 containerNumber String
 deviceNumber String
 sealedAt DateTime
 sealReference String
 status String @default("Draft")
 procurementCaseId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([procurementCaseId])
 linkedProcurementCaseId ProcurementCase @relation("Container_procurementCaseId", fields: [procurementCaseId], references: [id], onDelete: Restrict)
 inverseShipmentContainer_containerId ShipmentContainer[] @relation("ShipmentContainer_containerId")
 inverseTelemetryObservation_containerId TelemetryObservation[] @relation("TelemetryObservation_containerId")
}

model ShipmentContainer {
 id String @id @default(cuid())
 title String
 authorizedShipmentId String
 containerId String
 packedAt DateTime
 packer String
 status String @default("Draft")
 procurementCaseId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([procurementCaseId])
 linkedAuthorizedShipmentId AuthorizedShipment @relation("ShipmentContainer_authorizedShipmentId", fields: [authorizedShipmentId], references: [id], onDelete: Restrict)
 linkedContainerId Container @relation("ShipmentContainer_containerId", fields: [containerId], references: [id], onDelete: Restrict)
 linkedProcurementCaseId ProcurementCase @relation("ShipmentContainer_procurementCaseId", fields: [procurementCaseId], references: [id], onDelete: Restrict)
}

model TransportLeg {
